{
  "name": "@the-good-pixel/ticketloop",
  "version": "0.2.0",
  "description": "A local, subscription-powered Claude or Codex agent that watches your tracker and runs a configurable dev-cycle loop with a quota and history dashboard.",
  "keywords": [
    "coding-agent",
    "claude-code",
    "codex",
    "linear",
    "workflow-automation",
    "developer-tools"
  ],
  "homepage": "https://github.com/the-good-pixel/ticketloop#readme",
  "bugs": {
    "url": "https://github.com/the-good-pixel/ticketloop/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-good-pixel/ticketloop.git"
  },
  "type": "module",
  "bin": {
    "ticketloop": "bin/ticketloop.mjs"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "dev": "tsx watch src/cli.ts watch",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke-workflows.ts && tsx scripts/smoke-support.ts && tsx scripts/smoke-watchdog.ts && tsx scripts/smoke-runner-timeout.ts",
    "check": "npm run typecheck && node --check src/web/app.js && node --check src/web/catalog.js && node --check src/web/wfdiagram.js && npm run smoke",
    "test": "npm run check",
    "prepack": "npm run check"
  },
  "files": [
    "bin/",
    "src/",
    "docs/assets/",
    "README.md",
    "SETUP.md",
    "LICENSE",
    "SECURITY.md",
    "SUPPORTED_PLATFORMS.md",
    "UPGRADING.md",
    "CHANGELOG.md",
    "ticketloop.config.example.yml"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "dependencies": {
    "tsx": "^4.23.12",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^26.3.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
